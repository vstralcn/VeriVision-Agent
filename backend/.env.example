ENVIRONMENT=development
DATABASE_URL=postgresql://deepfake_user:deepfake_pass@127.0.0.1:5432/deepfake_db
SECRET_KEY=replace-with-a-random-jwt-secret
CERTIFICATION_KEY=replace-with-a-separate-random-certification-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

CREATE_DEFAULT_USERS=true
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-this-development-password
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_PASSWORD=change-this-development-password

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_PIXELS=40000000

MODEL_PATH=app/ml_models/weights/best.pt
USE_GPU=false
